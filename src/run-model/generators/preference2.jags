model
  {
    for (i in 1:n.obs)
      {
      
        ## Model: Main effects, interaction, random respondent effect
        mu[i] <- b0 + b1*x1[i] + b2*x2[i] + b12*x1[i]*x2[i] + re[resp[i]]
        
        ## Gaussian error
        y[i] ~ dnorm(mu[i],tau)
        
        ## Inverse logit of prediction
        p.mu[i] <- 1/(1 + exp(-mu[i]))
      }
      
    ## Model for random effect
    for (i in 1:n.resp)
      {
        re[i] ~ dnorm(0, re.tau)
      }

    ## Generate model predictions for an 11 x 11 grid of X1 and X2
#    for (i in 1:11)
#      {
#        xp1[i] <- ifelse(i==1, nudge, ifelse(i==11, 1-nudge, (i-1)/10))
#        xp2[i] <- xp1[i]
#        lxp1[i] <- logit(xp1[i])
#        lxp2[i] <- lxp1[i]
#      }
#    for (i in 1:11)
#      {
#        for (j in 1:11)
#          {
#            logit(pp[i,j]) <- b0 + b1*lxp1[i] + b2*lxp2[j] + b12*lxp1[i]*lxp2[j]
#          }
#      }
      
      
    ## Generate model predictions for fine divisions within each state, obtain mean
    # State 1: 0-10% established, SD (0/200 - 10/200)
    for (i in 1:S[1,3])
      {
        for (j in 1:S[1,6])
          {
          
              # Convert i index to a point between S[1,1] and S[1,2] on proportion scale
            zp1.1[i,j] <- S[1,1] + S[1,2]*(i-1)/(S[1,3]-1)
            
              # Check to see if zp1.1 is at 0 or 1, then nudge away to allow logit transformation
            xp1.1[i,j] <- ifelse(zp1.1[i,j]==0, nudge, ifelse(zp1.1[i,j]==1, 1-nudge, zp1.1[i,j]))
            
              # Convert j index to a point between S[1,4] and S[1,5] on proportion scale
            zp1.2[i,j] <- S[1,4] + S[1,5]*(j-1)/(S[1,6]-1)
            
              # Check to see if zp1.2 is at 0 or 1, then nudge away to allow logit transformation
            xp1.2[i,j] <- ifelse(zp1.2[i,j]==0, nudge, ifelse(zp1.2[i,j]==1, 1-nudge, zp1.2[i,j]))
            
              # Logit transformations
            lxp1.1[i,j] <- logit(xp1.1[i,j])
            lxp1.2[i,j] <- logit(xp1.2[i,j])
            
              # Apply model
            logit(pp1[i,j]) <- b0 + b1*lxp1.1[i,j] + b2*lxp1.2[i,j] + b12*lxp1.1[i,j]*lxp1.2[i,j]
            
          }
      }
    mp[1] <- mean(pp1)  ## Compute mean for this state

    # State 2: 0-10% established, SD (11/200 - 200/200)
    for (i in 1:S[2,3])
      {
        for (j in 1:S[2,6])
          {
            zp2.1[i,j] <- S[2,1] + S[2,2]*(i-1)/(S[2,3]-1)
            xp2.1[i,j] <- ifelse(zp2.1[i,j]==0, nudge, ifelse(zp2.1[i,j]==1, 1-nudge, zp2.1[i,j]))
            zp2.2[i,j] <- S[2,4] + S[2,5]*(j-1)/(S[2,6]-1)
            xp2.2[i,j] <- ifelse(zp2.2[i,j]==0, nudge, ifelse(zp2.2[i,j]==1, 1-nudge, zp2.2[i,j]))
            lxp2.1[i,j] <- logit(xp2.1[i,j])
            lxp2.2[i,j] <- logit(xp2.2[i,j])
            logit(pp2[i,j]) <- b0 + b1*lxp2.1[i,j] + b2*lxp2.2[i,j] + b12*lxp2.1[i,j]*lxp2.2[i,j]
          }
      }
    mp[2] <- mean(pp2)

    # State 3: 11-50% established, SD (0/200 - 10/200)
    for (i in 1:S[3,3])
      {
        for (j in 1:S[3,6])
          {
            zp3.1[i,j] <- S[3,1] + S[3,2]*(i-1)/(S[3,3]-1)
            xp3.1[i,j] <- ifelse(zp3.1[i,j]==0, nudge, ifelse(zp3.1[i,j]==1, 1-nudge, zp3.1[i,j]))
            zp3.2[i,j] <- S[3,4] + S[3,5]*(j-1)/(S[3,6]-1)
            xp3.2[i,j] <- ifelse(zp3.2[i,j]==0, nudge, ifelse(zp3.2[i,j]==1, 1-nudge, zp3.2[i,j]))
            lxp3.1[i,j] <- logit(xp3.1[i,j])
            lxp3.2[i,j] <- logit(xp3.2[i,j])
            logit(pp3[i,j]) <- b0 + b1*lxp3.1[i,j] + b2*lxp3.2[i,j] + b12*lxp3.1[i,j]*lxp3.2[i,j]
          }
      }
    mp[3] <- mean(pp3)

    # State 4: 11-50% established, SD (11/200 - 200/200)
    for (i in 1:S[4,3])
      {
        for (j in 1:S[4,6])
          {
            zp4.1[i,j] <- S[4,1] + S[4,2]*(i-1)/(S[4,3]-1)
            xp4.1[i,j] <- ifelse(zp4.1[i,j]==0, nudge, ifelse(zp4.1[i,j]==1, 1-nudge, zp4.1[i,j]))
            zp4.2[i,j] <- S[4,4] + S[4,5]*(j-1)/(S[4,6]-1)
            xp4.2[i,j] <- ifelse(zp4.2[i,j]==0, nudge, ifelse(zp4.2[i,j]==1, 1-nudge, zp4.2[i,j]))
            lxp4.1[i,j] <- logit(xp4.1[i,j])
            lxp4.2[i,j] <- logit(xp4.2[i,j])
            logit(pp4[i,j]) <- b0 + b1*lxp4.1[i,j] + b2*lxp4.2[i,j] + b12*lxp4.1[i,j]*lxp4.2[i,j]
          }
      }
    mp[4] <- mean(pp4)

    # State 5: 51-100% established, SD (0/200 - 10/200)
    for (i in 1:S[5,3])
      {
        for (j in 1:S[5,6])
          {
            zp5.1[i,j] <- S[5,1] + S[5,2]*(i-1)/(S[5,3]-1)
            xp5.1[i,j] <- ifelse(zp5.1[i,j]==0, nudge, ifelse(zp5.1[i,j]==1, 1-nudge, zp5.1[i,j]))
            zp5.2[i,j] <- S[5,4] + S[5,5]*(j-1)/(S[5,6]-1)
            xp5.2[i,j] <- ifelse(zp5.2[i,j]==0, nudge, ifelse(zp5.2[i,j]==1, 1-nudge, zp5.2[i,j]))
            lxp5.1[i,j] <- logit(xp5.1[i,j])
            lxp5.2[i,j] <- logit(xp5.2[i,j])
            logit(pp5[i,j]) <- b0 + b1*lxp5.1[i,j] + b2*lxp5.2[i,j] + b12*lxp5.1[i,j]*lxp5.2[i,j]
          }
      }
    mp[5] <- mean(pp5)

    # State 6: 51-100% established, SD (11/200 - 200/200)
    for (i in 1:S[6,3])
      {
        for (j in 1:S[6,6])
          {
            zp6.1[i,j] <- S[6,1] + S[6,2]*(i-1)/(S[6,3]-1)
            xp6.1[i,j] <- ifelse(zp6.1[i,j]==0, nudge, ifelse(zp6.1[i,j]==1, 1-nudge, zp6.1[i,j]))
            zp6.2[i,j] <- S[6,4] + S[6,5]*(j-1)/(S[6,6]-1)
            xp6.2[i,j] <- ifelse(zp6.2[i,j]==0, nudge, ifelse(zp6.2[i,j]==1, 1-nudge, zp6.2[i,j]))
            lxp6.1[i,j] <- logit(xp6.1[i,j])
            lxp6.2[i,j] <- logit(xp6.2[i,j])
            logit(pp6[i,j]) <- b0 + b1*lxp6.1[i,j] + b2*lxp6.2[i,j] + b12*lxp6.1[i,j]*lxp6.2[i,j]
          }
      }
    mp[6] <- mean(pp6)
    
    
    
    #priors
    b0 ~ dnorm(0, 0.37)
    b1 ~ dnorm(0, 0.37)
    b2 ~ dnorm(0, 0.37)
    b12 ~ dnorm(0, 0.37)  ## Use this line to model interaction
#    b12 <- 0          ## Use this line to remove interaction
    tau <- 1/(sd*sd)
    sd ~ dunif(0,5)
    re.tau <- 1/(re.sd*re.sd)
    re.sd ~ dunif(0,5)
  }
